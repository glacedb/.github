# EditorConfig — https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab


# =============================================================================
# Rust  (added by config standardization)
# =============================================================================
#
# rustfmt uses 4-space indentation and a 100-column width.
# https://rust-lang.github.io/rustfmt/
#
# -----------------------------------------------------------------------------

[*.rs]
indent_style               = space
indent_size                = 4
max_line_length            = 100


# =============================================================================
# Go  (added by config standardization)
# =============================================================================
#
# gofmt requires TAB indentation; it does not enforce a line length.
# https://pkg.go.dev/cmd/gofmt
#
# -----------------------------------------------------------------------------

[*.go]
indent_style               = tab
tab_width                  = 4
max_line_length            = off
